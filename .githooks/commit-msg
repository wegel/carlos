#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file required}"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

if grep -Eiq '^Co-authored-by:' "$message_file"; then
  fail 'commit message must not include Co-Authored-By unless explicitly requested'
fi

mapfile -t lines < <(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$message_file")

if [[ "${#lines[@]}" -ne 1 ]]; then
  fail 'commit message must match "<scope>: <subject>" with no body'
fi

subject="${lines[0]}"

if [[ ! "$subject" =~ ^[a-z0-9-]+:\ .+ ]]; then
  fail 'commit message must match "<scope>: <subject>"'
fi

if [[ "$subject" == *. ]]; then
  fail 'commit message subject must not end with a period'
fi
